__pycache__/
*.py[cod]
.codex
.agents/
.vscode/

# Project Chrono is treated as a local simulator dependency, not vendored source.
chrono/

# ---------------------------------------------------------------------------
# artifacts/
#
# Deny everything, then re-include exactly the runs and outputs that reproduce
# the manuscript. This is an allowlist on purpose: the previous deny-all rule
# forced every kept run to be `git add -f`'d by hand, and the runs added that
# way went stale -- the reported L8 and 8-D policies were never committed at
# all. With an allowlist, a paper artifact that is missing a rule shows up in
# `git status` instead of silently staying untracked.
#
# Raw episode CSVs (artifacts/datasets, ~337 GB) and processed cache arrays
# (artifacts/training_datasets, ~73 GB) are never in git; the paper's five
# datasets and four caches are published on Hugging Face (see README) and
# scripts/release/download_nedm_datasets.py puts them back here. The staged
# release mirror (artifacts/hf_release) is local-only too.
# ---------------------------------------------------------------------------
artifacts/*

# --- Small ablation result tables (JSON) -------------------------------------
!artifacts/ablations/
artifacts/ablations/*
!artifacts/ablations/arm_q_input/

# --- Dynamics-model training runs ------------------------------------------
!artifacts/training_runs/
artifacts/training_runs/*
# Study Case I: the OFAT architecture sweep, plus its data-quantity, data-mix
# and feature arms. One directory serves the terrain-conditioned model, both
# single-terrain specialists, and Appendices C, D and E.
!artifacts/training_runs/ablation_ofat/
# Study Case I: the shared 6-layer anchor (ablation model 10), trained once.
!artifacts/training_runs/hmmwv_transformer_v07_tire_normal_force_omega_300g_crm2000_mix25_rebal_rollout_onehot/
# Study Case II: the two deployed reduced models.
!artifacts/training_runs/arm_transformer_8d_v1/
!artifacts/training_runs/tracked_transformer_v1/
# Study Case II: arm-ROM input ablation ("why [q, qd] and not qd-only + integrate
# q"), see docs/arm_rom_q_input_ablation.md. Same recipe as arm_transformer_8d_v1.
!artifacts/training_runs/arm_transformer_8d_qdonly_v1/
!artifacts/training_runs/arm_transformer_8d_integq_v1/

# Within a kept run: metadata and the selected checkpoint only. best_val.pt is
# written by the `rollout_sel` selection metric, so it is the rollout-selected
# epoch, not the lowest one-step loss.
artifacts/training_runs/*_interrupted_*/
artifacts/training_runs/**/*.tmux_session
artifacts/training_runs/**/plots/
artifacts/training_runs/**/checkpoints/*
!artifacts/training_runs/**/checkpoints/best_val.pt

# --- RL runs ----------------------------------------------------------------
!artifacts/rl_runs/
artifacts/rl_runs/*
# Study Case I: the three tracking policies compared in the policy-transfer
# table, each with its nine-cell Chrono evaluation output.
!artifacts/rl_runs/hmmwv_rl_15d_crm2000mix25_onehot_ofatL8_bestval51_flat20crm20_K16_64steps_ar02_state_vxvyyr_pos2_yaw2_steerlim010/
!artifacts/rl_runs/hmmwv_rl_15d_crm2000mix00_onehot_ofatL8_bestval61_rigid20_K16_64steps_ar02_state_vxvyyr_pos2_yaw2_steerlim010_1000it/
!artifacts/rl_runs/hmmwv_rl_15d_crm2000mix100_onehot_ofatL8_bestval54_crmonly20_K16_64steps_ar02_state_vxvyyr_pos2_yaw2_steerlim010_1000it/
!artifacts/rl_runs/chrono_eval_comparisons/
# Study Case II: the tracked-base goal-reaching policy transferred to Chrono
# (100/100). Its own tfevents feed the reward figure.
!artifacts/rl_runs/tracked_goal_v2_far_rollsel_rom_20260721/
# Study Case II: the arm end-effector reaching policy transferred to Chrono
# (97/100).
!artifacts/rl_runs/arm_reach_adaptivekl005_lr1e4_tol005_ep150_bonus150_sigma015_8d_rom_20260727/

# Consecutive-waypoint routes: the manuscript figure chains eight goals along
# the bowtie route; the square and plain fig-8 routes were exploratory.
artifacts/rl_runs/tracked_goal_v2_far_rollsel_rom_20260721/chrono_waypoints_*/
!artifacts/rl_runs/tracked_goal_v2_far_rollsel_rom_20260721/chrono_waypoints_fig8_bowtie/

# NRD follow-on (docs/vision/double_pen/rl_implementation_notes.md and
# distillation_implementation_notes.md): the state-only reaching policy trained
# inside the frozen NRD (final checkpoint only) with its paired NRD/Chrono
# evaluations, and the three distilled camera-only students (best/last
# checkpoints, teacher-vs-student evaluations, Chrono chain with the frames the
# student actually saw). Intermediate checkpoints stay local.
!artifacts/rl_runs/dpend_nrd_reach_z1_armreward_lowerhalf_seed1_20260826/
artifacts/rl_runs/dpend_nrd_reach_z1_armreward_lowerhalf_seed1_20260826/model_*.pt
!artifacts/rl_runs/dpend_nrd_reach_z1_armreward_lowerhalf_seed1_20260826/model_1499.pt
!artifacts/rl_runs/dpend_nrd_student_z2hist4_from_z1_armreward_lowerhalf_seed1_20260826/
!artifacts/rl_runs/dpend_nrd_student_z2hist4_from_z1_armreward_lowerhalf_seed2_20260826/
!artifacts/rl_runs/dpend_nrd_student_z2hist4_from_z1_armreward_lowerhalf_seed3_20260826/
artifacts/rl_runs/dpend_nrd_student_*/student_0*.pt

# Rendered frame dumps and tmux bookkeeping inside a kept RL run stay local.
artifacts/rl_runs/**/frames/
artifacts/rl_runs/**/renders/
artifacts/rl_runs/**/*.tmux_session

